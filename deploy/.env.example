# Copy to .env next to docker-compose.yml and fill in. Every host is inside the air-gapped network.

# Image tag loaded from the bundle (build-and-export.sh sets this).
VT_VERSION=__VERSION__

# ---- secrets (required) ----
# Long random strings, e.g. from: openssl rand -hex 32
# VT_SECRET_KEY encrypts stored GitLab tokens: keep it safe and never change it (users would re-enter tokens).
VT_SECRET_KEY=
POSTGRES_PASSWORD=

# ---- GitLab ----
VT_GITLAB_URL=https://gitlab.internal
# The internal CA certificate is mounted from ./certs/ca.pem. If GitLab's certificate is issued by a CA
# that the image already trusts, point this at the system bundle instead:
# VT_CA_BUNDLE_IN_CONTAINER=/etc/ssl/certs/ca-certificates.crt

# ---- local model (vLLM, OpenAI-compatible) ----
VT_LLM_BASE_URL=http://vllm.internal:8000/v1
VT_LLM_MODEL=your-served-model-name
VT_LLM_API_KEY=EMPTY
VT_LLM_STRUCTURED_OUTPUT=true
# Model requests one analysis sends at the same time (1-32; vLLM processes them together). Admins can change
# it on the Admin page. Lower it if vLLM runs out of memory or requests time out.
# VT_LLM_PARALLEL=4
# Longest triage reply in tokens (1024-32768; also on the Admin page). A reply cut off at this limit is retried once
# with twice as many. Raise it if findings fail with "cut off" or "wasn't valid JSON".
# VT_LLM_MAX_TOKENS=4096
# Default for new analyses: let the model think before it answers (Qwen3 enable_thinking). Thinking is slower and
# uses more of the token limit; users can switch it per analysis, and admins on the Admin page.
# VT_LLM_THINKING=true
# Optional, needs an image built with INSTALL_TOKENIZER=1 and the tokenizer files mounted:
# VT_TOKENIZER_PATH=/models/tokenizer

# ---- analysis ----
VT_CONTEXT_TOKEN_BUDGET=100000
VT_TRIAGE_VOTES=3
VT_WORKER_THREADS=2
VT_VALIDATION_TIMEOUT_S=900
# Optional MITRE CWE catalogue, placed in ./rules and so mounted at /opt/rules:
# VT_CWE_XML=/opt/rules/cwec_v4.15.xml

# ---- web ----
# Host port the app is served on over plain HTTP (no nginx). Pick any free port; check first with:
#   ss -ltn | grep ':8080 '   and   docker ps --format '{{.Names}}\t{{.Ports}}'
# Plain HTTP sends passwords and GitLab tokens unencrypted: use it only on a trusted network.
HTTP_PORT=8080
VT_COOKIE_SECURE=false

# ---- HTTPS via nginx (later) ----
# Uncomment all four, add certs/server.crt + certs/server.key, and remove the web service's "ports:" entry
# in docker-compose.yml so the app is only reachable through the proxy.
# COMPOSE_PROFILES=https
# HTTPS_PORT=443
# VT_COOKIE_SECURE=true
# VT_TRUSTED_PROXIES=*
# Directory with semgrep rules for the fix re-scan (mounted read-only at /opt/rules).
SEMGREP_RULES_DIR=./rules
